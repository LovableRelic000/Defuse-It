<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <!-- Cartoon Bomb Fuse Ring around the outer bezel -->
    <com.defuseit.watch.FuseRingView
        android:id="@+id/fuseRingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Safe Inner Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <!-- Row 1: Compact HUD (Timer + Strikes + Bezel Mode Pill) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvGameTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:00"
                android:textColor="@color/warning_yellow"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvGameStrikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="[ ] [ ] [ ]"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvBezelMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BISEL: ACCIÓN"
                android:textColor="@color/warning_yellow"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/badge_bezel_mode"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- Row 2: Compact Module Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnNavPrev"
                android:layout_width="26dp"
                android:layout_height="22dp"
                android:text="◀"
                android:textSize="9sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/btn_round_dark"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tvModuleTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1/6: CABLES"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnNavNext"
                android:layout_width="26dp"
                android:layout_height="22dp"
                android:text="▶"
                android:textSize="9sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/btn_round_dark"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Main Module Workspace -->
        <FrameLayout
            android:id="@+id/moduleContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp">

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
