<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_black"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SALA EMPAREJADA"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvLobbyPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="PIN: 1234"
        android:textColor="@color/warning_yellow"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/tvLobbyStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Esperando al Experto en el teléfono o pulsa abajo para armar la bomba."
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnLobbyStart"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="12dp"
        android:text="¡ARMAR BOMBA!"
        android:textColor="@color/danger_red"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/btn_round_red"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <Button
        android:id="@+id/btnLobbyDisconnect"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:text="Salir"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:background="@drawable/btn_round_dark"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</LinearLayout>
