<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_black"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SALA EMPAREJADA"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvLobbyPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="PIN: 1234"
        android:textColor="@color/warning_yellow"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvLobbyStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Esperando inicio o pulsa abajo:"
        android:textColor="@color/text_secondary"
        android:textSize="9sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/btnLobbyStart"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:text="¡ARMAR BOMBA!"
        android:textColor="@color/danger_red"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/btn_round_red"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnLobbyDisconnect"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="5dp"
        android:text="Desconectar"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:background="@drawable/btn_round_dark"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
